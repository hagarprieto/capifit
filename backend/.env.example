# Copie para .env (ignorado pelo Git) e preencha. NUNCA versione valores reais.
APP_ENV=local

# Banco de dados — a aplicação usa o usuário de menor privilégio (somente DML)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=capifit
DB_USER=capifit_app
DB_PASSWORD=

# Origens permitidas para o painel web (separadas por vírgula). Vazio = nenhuma origem cross-origin.
CORS_ORIGINS=

# Tamanho máximo do corpo da requisição, em bytes (padrão: 1 MB)
MAX_BODY_BYTES=1048576

# Autenticação — JWT_SECRET: mínimo de 32 bytes aleatórios. Gere com:
#   php -r "echo bin2hex(random_bytes(32));"
# Nunca reutilize o mesmo segredo entre ambientes. Rotação: Documento 12 §5.2.
JWT_SECRET=
JWT_ISSUER=capifit
# Validade do access token (segundos) e do refresh token (segundos; 2592000 = 30 dias)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Tolerância (segundos) para duas renovações simultâneas do mesmo token antes de tratar como roubo
REFRESH_REUSE_GRACE=10

# Mídia aprovada (CDN/storage privado). As URLs entregues são temporárias e assinadas (HMAC-SHA256, ver MediaUrlSigner).
# Sem MEDIA_BASE_URL ou sem MEDIA_SIGNING_SECRET (mínimo 32 bytes aleatórios) as mídias são omitidas.
# MEDIA_URL_TTL: validade da URL em segundos (60 a 3600).
MEDIA_BASE_URL=
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL=600

# Exportação de dados do titular (E02-02). EXPORT_DIR: pasta PRIVADA onde o workflow grava os arquivos (padrão: storage/exports).
# A URL de download é temporária e assinada (mesmo esquema da mídia); sem EXPORT_BASE_URL e EXPORT_SIGNING_SECRET
# (32+ bytes) o pedido conclui, mas a API não devolve link. EXPORT_URL_TTL: validade em segundos (60 a 3600).
EXPORT_DIR=
EXPORT_BASE_URL=
EXPORT_SIGNING_SECRET=
EXPORT_URL_TTL=900

# Limite de taxa nas rotas /auth/* (1 = ligado). Desligue só em testes.
RATE_LIMIT_ENABLED=1
# Use o IP de X-Forwarded-For apenas atrás de um proxy confiável que SOBRESCREVE o cabeçalho.
TRUST_FORWARDED_FOR=0

# Links enviados por e-mail (o app abre pelo esquema capifit://; o token vai em ?token=). Em produção, use https://.
PASSWORD_RESET_URL=capifit://redefinir-senha
EMAIL_VERIFY_URL=capifit://verificar-email
